# DarkWatch AI Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# Server runs on port 3000. Do NOT expose secrets to client-side bundles.

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI Reasoning (Server-side Proxy)
# Used for AI Threat Analysis & Playbook Decision Reasoning via @google/genai
GEMINI_API_KEY=

# SMS Provider & Mobile OTP Configuration
# Supported providers: TWILIO, FAST2SMS, MSG91, or unconfigured dev mode
# If credentials are omitted, the server operates in transparent dev mode and logs OTPs
# securely to the console for testing.
SMS_PROVIDER=
# Twilio (Global SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Fast2SMS (Indian carrier SMS gateway)
FAST2SMS_API_KEY=
# MSG91 (Transactional SMS route)
MSG91_AUTH_KEY=
MSG91_FLOW_ID=

# Optional Email Dispatch Configuration (Optional alerts)
RESEND_API_KEY=
EMAIL_FROM="DarkWatch Security <security@darkwatch.corp>"

# Optional SMTP Settings (alternative to Resend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SIEM Ingestion Security
# Optional API Key for securing /api/siem/events webhook endpoints
SIEM_INGEST_API_KEY=

# Authenticity & Threat Verification Providers (Optional)
# If unconfigured, honest UNVERIFIED indicators and format checks are returned.
PHONE_REPUTATION_API_KEY=
NUMVERIFY_API_KEY=
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Optional Cloud Database Persistence (Firebase / Google Cloud)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
